# Copy this file to backend/.env. Never commit credentials.
DATABASE_URL=sqlite:///./data/studypath.db
# Leave QDRANT_URL empty to use persistent embedded Qdrant at ./data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
FASTEMBED_CACHE_PATH=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional server-side AgentHarness credential. Execution remains disabled until
# the exact provider/product contract, endpoint and agent identifiers are verified.
AGENTHARNESS_API=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; enables /api/admin content CRUD. Keep this token server-side.
CONTENT_ADMIN_TOKEN=
# Comma-separated usernames allowed to manage curriculum, for example: alice,teacher01
CONTENT_ADMIN_USERNAMES=
MAX_UPLOAD_MB=20
LOGIN_IP_LIMIT=30
LOGIN_USER_IP_LIMIT=10
REGISTER_IP_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
INDEX_WORKER_ENABLED=true
RETRIEVAL_CANDIDATES=16
FINAL_EVIDENCE_COUNT=5
MIN_EVIDENCE_SCORE=0.78
# Re-calibrate this floor whenever the reranker, embedding model or course corpus changes.
MAX_EVIDENCE_PER_DOCUMENT=3
MAX_EVIDENCE_PER_SECTION=2
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CONCURRENCY=8
# Optional scanned PDF and DOCX image OCR. Install Tesseract and chi_sim/eng data first.
OCR_ENABLED=false
OCR_LANGUAGES=chi_sim+eng
OCR_MAX_PAGES=30
OCR_DPI=180
TESSERACT_CMD=
# On Windows, keep this directory path ASCII-only (e.g. D:/StudyPathAI/tessdata).
TESSDATA_DIR=
# Calibrated against the local 56-question set; fails closed if reranking fails.
RERANKER_MIN_SCORE=-1.002625
